# Anthropic API key — powers the AI Tutor, Mark Scheme Simulator and PDF ingestion.
# Get one at https://console.anthropic.com/settings/keys
# The rest of the platform (summaries, flashcards, quizzes, worked solutions,
# analytics, planner) works fully offline without it.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model used for tutoring (defaults to claude-sonnet-5)
# TUTOR_MODEL=claude-sonnet-5
